# Replace placeholders, then export values or set the IDE environment for a local JAR.
# Docker Compose reads a copy at Infra/roomly/.env through --env-file roomly/.env.
ROOMLY_DB_HOST=127.0.0.1
ROOMLY_DB_PORT=3306
# Local JDBC prefers TLS; Compose requires TLS on its private MySQL connection.
ROOMLY_DB_SSL_MODE=PREFERRED
ROOMLY_DATABASE=roomly
ROOMLY_DB_USER=roomly
ROOMLY_DB_PASSWORD=replace-with-local-database-password
ROOMLY_JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes
ROOMLY_HTTP_PORT=18092
ROOMLY_BIND_ADDRESS=127.0.0.1
# Relative to backend/ for a local JAR; use the existing absolute media path when reusing data.
ROOMLY_MEDIA_DIRECTORY=../Infra/roomly/.local/media
ROOMLY_MAIL_ENABLED=false
ROOMLY_MOCK_PAYMENT_ENABLED=true
ROOMLY_PUSH_ENABLED=false
ROOMLY_FIREBASE_PROJECT_ID=
ROOMLY_FIREBASE_CREDENTIALS=

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=sender@example.invalid
SMTP_PASSWORD=replace-with-local-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=sender@example.invalid

# Required only for the MySQL container; never reuse the application's DB password.
ROOMLY_MYSQL_ROOT_PASSWORD=replace-with-separate-local-root-password
ROOMLY_MYSQL_HOST_PORT=3307
